# ============================================================
# Drone-to-BIM Semantic Segmentation Pipeline
# ============================================================

import yaml
import glob
import os

CONFIG_FILE = "pipeline/config.yaml"

with open(CONFIG_FILE) as f:
    cfg = yaml.safe_load(f)

# ------------------------------------------------------------
# Configuration
# ------------------------------------------------------------

DATASET_PATH = cfg["dataset"]["path"]
DATASET_NAME = cfg["dataset"]["name"]
HAS_GPS = cfg["dataset"]["has_gps"]

DATASET_OUTPUT_DIR = f"outputs/{DATASET_NAME}"

ENV_COLMAP = cfg["colmap"]["conda_env"]
ENV_NERFSTUDIO = cfg["garfield"]["conda_env"]

CROP_CENTER = cfg["garfield"]["crop_center"]
CROP_SCALE = cfg["garfield"]["crop_scale"]

PROJECTION_SCALE = cfg["projection"]["scale"]
PROJECTION_OUTPUT = os.path.join(
    DATASET_OUTPUT_DIR,
    os.path.basename(cfg["projection"]["output_dir"])
)

# Keep the point cloud generated by the existing export rule.
PC_PATH = os.path.join(
    DATASET_OUTPUT_DIR,
    "exports",
    os.path.basename(cfg["projection"]["pointcloud"])
)

CLUSTER_DIR = os.path.join(
    DATASET_OUTPUT_DIR,
    os.path.basename(cfg["clustering"]["output_dir"])
)

CLUSTER_N_TRIALS = cfg["clustering"].get("n_trials", 40)
CLUSTER_SAMPLE_SIZE = cfg["clustering"].get("sample_size", 50000)

MERGE_DIR = os.path.join(
    DATASET_OUTPUT_DIR,
    os.path.basename(cfg["merging"]["output_dir"])
)

SAM_CACHE = cfg["merging"]["sam_cache"]
MIN_CLUSTER_FRACTION = cfg["merging"].get("min_cluster_fraction", 0.50)
MIN_SUPPORT = cfg["merging"].get("min_support", 50)
MIN_COSINE = cfg["merging"].get("min_cosine", 0.90)

VIEWS_DIR = os.path.join(
    DATASET_OUTPUT_DIR,
    os.path.basename(cfg["labeling_views"]["output_dir"])
)

MASKS_DIR = os.path.join(
    DATASET_OUTPUT_DIR,
    "labeling_masks_finetuned"
)

SEMANTIC_OUTPUT = os.path.join(
    DATASET_OUTPUT_DIR,
    os.path.basename(cfg["matching"]["output_dir"])
)

MATCH_MIN_IOU = cfg["matching"]["min_iou"]

TRAINING_POSES = os.path.join(
    DATASET_OUTPUT_DIR,
    "training_camera_poses.npy"
)

GARFIELD_CONFIG_TXT = os.path.join(
    DATASET_OUTPUT_DIR,
    "garfield_config.txt"
)

GAUSS_CONFIG_TXT = os.path.join(
    DATASET_OUTPUT_DIR,
    "garfield_gauss_config.txt"
)

GARFIELD_DONE = os.path.join(
    DATASET_OUTPUT_DIR,
    ".garfield_train_done"
)

GAUSS_DONE = os.path.join(
    DATASET_OUTPUT_DIR,
    ".garfield_gauss_train_done"
)

SAM3_DONE = os.path.join(
    DATASET_OUTPUT_DIR,
    ".sam3_inference_done"
)

# ------------------------------------------------------------
# HPC / SAM3
# ------------------------------------------------------------

HPC_USER = cfg["hpc"]["user"]
HPC_HOST = cfg["hpc"]["host"]
HPC_WORK = cfg["hpc"]["work_dir"]
HPC_ACCOUNT = cfg["hpc"]["account"]
HPC_PARTITION = cfg["hpc"]["partition"]

HPC_CONDA_ENV = cfg["sam3"]["hpc_conda_env"]

# ============================================================
# Target
# ============================================================

rule all:
    input:
        f"{SEMANTIC_OUTPUT}/semantic_pointcloud.ply"


# ============================================================
# Stage 1: COLMAP
# ============================================================

rule colmap_feature_extract:
    input:
        images = f"{DATASET_PATH}/images"
    output:
        db = f"{DATASET_PATH}/database.db"
    shell:
        """
        set +u; source activate {ENV_COLMAP}; set -u

        colmap feature_extractor \
            --database_path {output.db} \
            --image_path {input.images}
        """


rule colmap_matching:
    input:
        db = ancient(f"{DATASET_PATH}/database.db")
    output:
        done = touch(f"{DATASET_PATH}/.matching_done")
    run:
        if HAS_GPS:
            shell(
                "set +u; source activate {ENV_COLMAP}; set -u; "
                "colmap spatial_matcher --database_path {input.db}"
            )
        else:
            shell(
                "set +u; source activate {ENV_COLMAP}; set -u; "
                "colmap sequential_matcher --database_path {input.db}"
            )


rule colmap_mapper:
    input:
        db = f"{DATASET_PATH}/database.db",
        done = f"{DATASET_PATH}/.matching_done",
        images = f"{DATASET_PATH}/images"
    output:
        sparse = directory(f"{DATASET_PATH}/sparse/0")
    shell:
        """
        set +u; source activate {ENV_COLMAP}; set -u

        colmap mapper \
            --database_path {input.db} \
            --image_path {input.images} \
            --output_path {DATASET_PATH}

        mkdir -p {DATASET_PATH}/sparse

        [ -d "{DATASET_PATH}/0" ] && \
            mv {DATASET_PATH}/0 {DATASET_PATH}/sparse/ || true

        [ -d "{DATASET_PATH}/1" ] && \
            mv {DATASET_PATH}/1 {DATASET_PATH}/sparse/ || true
        """


rule colmap:
    input:
        f"{DATASET_PATH}/sparse/0"


# ============================================================
# Stage 2a: GARField Training
# ============================================================

rule garfield_train:
    input:
        sparse = f"{DATASET_PATH}/sparse/0"
    output:
        done = touch(GARFIELD_DONE),
        config_txt = GARFIELD_CONFIG_TXT
    shell:
        """
        echo "============================================"
        echo " Stage 2a: GARField Training"
        echo "============================================"

        set +u; source activate {ENV_NERFSTUDIO}; set -u

        ns-train garfield \
            --viewer.quit-on-train-completion True \
            colmap \
            --data {DATASET_PATH} \
            --colmap-path sparse/0/

        GARFIELD_CONFIG=$(realpath $(find outputs \
            -path "*/garfield/*/config.yml" \
            -type f \
            -printf "%T@ %p\\n" | \
            sort -nr | head -1 | cut -d" " -f2-))

        test -f "$GARFIELD_CONFIG"

        mkdir -p {DATASET_OUTPUT_DIR}

        echo "$GARFIELD_CONFIG" > {output.config_txt}

        echo "GARField training complete."
        echo "Config: $GARFIELD_CONFIG"
        """


# ============================================================
# Stage 2b: GARField-Gauss Training
# ============================================================

rule garfield_gauss_train:
    input:
        sparse = f"{DATASET_PATH}/sparse/0",
        garfield_done = GARFIELD_DONE,
        garfield_config_txt = GARFIELD_CONFIG_TXT
    output:
        done = touch(GAUSS_DONE),
        config_txt = GAUSS_CONFIG_TXT
    shell:
        """
        echo "============================================"
        echo " Stage 2b: GARField-Gauss Training"
        echo "============================================"

        GARFIELD_CONFIG=$(cat {input.garfield_config_txt})
        test -f "$GARFIELD_CONFIG"

        set +u; source activate {ENV_NERFSTUDIO}; set -u

        ns-train garfield-gauss \
            --pipeline.garfield-ckpt "$GARFIELD_CONFIG" \
            --viewer.quit-on-train-completion True \
            --pipeline.datamanager.camera-res-scale-factor 0.25 \
            --pipeline.datamanager.cache-images cpu \
            colmap \
            --data {DATASET_PATH} \
            --colmap-path sparse/0/

        GAUSS_CONFIG=$(realpath $(find outputs \
            -path "*/garfield-gauss/*/config.yml" \
            -type f \
            -printf "%T@ %p\\n" | \
            sort -nr | head -1 | cut -d" " -f2-))

        test -f "$GAUSS_CONFIG"

        mkdir -p {DATASET_OUTPUT_DIR}

        echo "$GAUSS_CONFIG" > {output.config_txt}

        echo "GARField-Gauss training complete."
        echo "Config: $GAUSS_CONFIG"
        """


# ============================================================
# Stage 3: Export GARField Point Cloud
# ============================================================

rule export_garfield_pointcloud:
    input:
        garfield_done = GARFIELD_DONE,
        garfield_config_txt = GARFIELD_CONFIG_TXT
    output:
        pc = PC_PATH
    shell:
        """
        GARFIELD_CONFIG=$(cat {input.garfield_config_txt})
        test -f "$GARFIELD_CONFIG"

        echo "============================================"
        echo " Exporting GARField Point Cloud"
        echo "============================================"

        set +u; source activate {ENV_NERFSTUDIO}; set -u

        ns-export pointcloud \
            --load-config "$GARFIELD_CONFIG" \
            --output-dir $(dirname {output.pc}) \
            --num-points 1000000 \
            --remove-outliers True \
            --normal-method open3d \
            --save-world-frame False

        test -f {output.pc}
        """


# ============================================================
# Stage 4: COLMAP-Guided + Roof Orthographic Projection
#
# NOTE:
# training_camera_poses.npy is currently a required input.
# ============================================================

rule ortho_projection:
    input:
        garfield_done = GARFIELD_DONE,
        garfield_config_txt = GARFIELD_CONFIG_TXT,
        pc = PC_PATH,
        poses = TRAINING_POSES,
        pipeline_cfg = CONFIG_FILE
    output:
        features = f"{PROJECTION_OUTPUT}/avg_features.npy",
        points = f"{PROJECTION_OUTPUT}/points.npy",
        colors = f"{PROJECTION_OUTPUT}/colors.npy"
    shell:
        """
        GARFIELD_CONFIG=$(cat {input.garfield_config_txt})
        test -f "$GARFIELD_CONFIG"

        echo "============================================"
        echo " Guided Orthographic Feature Projection"
        echo "============================================"

        set +u; source activate {ENV_NERFSTUDIO}; set -u

        python garfield/garfield_ortho_projection_guided_plus_top.py \
            --config "$GARFIELD_CONFIG" \
            --pointcloud {input.pc} \
            --scale {PROJECTION_SCALE} \
            --crop-center \
                {CROP_CENTER[0]} \
                {CROP_CENTER[1]} \
                {CROP_CENTER[2]} \
            --crop-scale \
                {CROP_SCALE[0]} \
                {CROP_SCALE[1]} \
                {CROP_SCALE[2]} \
            --output-dir {PROJECTION_OUTPUT}
        """


# ============================================================
# Stage 5: Fine HDBSCAN Clustering
# ============================================================

rule clustering:
    input:
        features = f"{PROJECTION_OUTPUT}/avg_features.npy",
        points = f"{PROJECTION_OUTPUT}/points.npy",
        colors = f"{PROJECTION_OUTPUT}/colors.npy"
    output:
        labels = f"{CLUSTER_DIR}/cluster_labels.npy",
        ply = f"{CLUSTER_DIR}/clustered_pointcloud.ply"
    shell:
        """
        echo "============================================"
        echo " Fine HDBSCAN Clustering"
        echo "============================================"

        set +u; source activate {ENV_NERFSTUDIO}; set -u

        python garfield/cluster_sweep_fine.py \
            --input-dir {PROJECTION_OUTPUT} \
            --output-dir {CLUSTER_DIR} \
            --n-trials {CLUSTER_N_TRIALS} \
            --sample-size {CLUSTER_SAMPLE_SIZE}
        """


# ============================================================
# Stage 6a: SAM2 Cluster-Pair Evidence
# ============================================================

rule cluster_pair_evidence:
    input:
        points = f"{PROJECTION_OUTPUT}/points.npy",
        labels = f"{CLUSTER_DIR}/cluster_labels.npy",
        garfield_config_txt = GARFIELD_CONFIG_TXT
    output:
        evidence = f"{CLUSTER_DIR}/sam2_cluster_pair_evidence.csv"
    shell:
        """
        GARFIELD_CONFIG=$(cat {input.garfield_config_txt})
        test -f "$GARFIELD_CONFIG"
        test -d {SAM_CACHE}

        echo "============================================"
        echo " SAM2 Cluster-Pair Evidence"
        echo "============================================"

        set +u; source activate {ENV_NERFSTUDIO}; set -u

        python garfield/generate_sam2_cluster_pair_evidence.py \
            --points {input.points} \
            --labels {input.labels} \
            --config "$GARFIELD_CONFIG" \
            --sam-cache {SAM_CACHE} \
            --output {output.evidence} \
            --min-cluster-fraction {MIN_CLUSTER_FRACTION}
        """


# ============================================================
# Stage 6b: SAM2 + GARField Merge Candidate Analysis
# ============================================================

rule merge_candidates:
    input:
        features = f"{PROJECTION_OUTPUT}/avg_features.npy",
        labels = f"{CLUSTER_DIR}/cluster_labels.npy",
        evidence = f"{CLUSTER_DIR}/sam2_cluster_pair_evidence.csv"
    output:
        candidates = f"{CLUSTER_DIR}/merge_candidates.csv"
    shell:
        """
        echo "============================================"
        echo " GARField Merge Candidate Analysis"
        echo "============================================"

        set +u; source activate {ENV_NERFSTUDIO}; set -u

        python garfield/analyze_cluster_merge_candidates.py \
            --features {input.features} \
            --labels {input.labels} \
            --evidence {input.evidence} \
            --min-support {MIN_SUPPORT} \
            --output {output.candidates}
        """


# ============================================================
# Stage 6c: Verified Conservative Cluster Merging
# ============================================================

rule merge_clusters:
    input:
        points = f"{PROJECTION_OUTPUT}/points.npy",
        labels = f"{CLUSTER_DIR}/cluster_labels.npy",
        candidates = f"{CLUSTER_DIR}/merge_candidates.csv"
    output:
        labels = f"{MERGE_DIR}/merged_labels.npy",
        ply = f"{MERGE_DIR}/merged_clustered_pointcloud.ply",
        groups = f"{MERGE_DIR}/merged_groups.csv"
    shell:
        """
        echo "============================================"
        echo " Conservative Cluster Merging"
        echo "============================================"

        set +u; source activate {ENV_NERFSTUDIO}; set -u

        python garfield/merge_clusters_from_candidates.py \
            --points {input.points} \
            --labels {input.labels} \
            --candidates {input.candidates} \
            --output-dir {MERGE_DIR} \
            --min-support {MIN_SUPPORT} \
            --min-cosine {MIN_COSINE}
        """


rule merging:
    input:
        f"{MERGE_DIR}/merged_labels.npy"


# ============================================================
# Stage 7: COLMAP-Guided Perspective Rendering
# ============================================================

rule render_views:
    input:
        gauss_done = GAUSS_DONE,
        gauss_config_txt = GAUSS_CONFIG_TXT,
        poses = TRAINING_POSES,
        pipeline_cfg = CONFIG_FILE
    output:
        params = f"{VIEWS_DIR}/view_params.json"
    shell:
        """
        GAUSS_CONFIG=$(cat {input.gauss_config_txt})
        test -f "$GAUSS_CONFIG"

        echo "============================================"
        echo " COLMAP-Guided Perspective Rendering"
        echo "============================================"

        set +u; source activate {ENV_NERFSTUDIO}; set -u

        python garfield/render_views_colmap_guided.py \
            --config "$GAUSS_CONFIG" \
            --output-dir {VIEWS_DIR} \
            --config-yaml {CONFIG_FILE}
        """


# ============================================================
# Stage 8: SAM3 Fine-Tuned Inference on LSU HPC
# ============================================================

rule sam3_inference:
    input:
        views = f"{VIEWS_DIR}/view_params.json",
        pipeline_cfg = CONFIG_FILE
    output:
        done = touch(SAM3_DONE)
    shell:
        """
        echo "============================================"
        echo " Stage 8: SAM3 Inference on HPC"
        echo "============================================"

        rm -f /tmp/hpc-snake

        ssh -M -S /tmp/hpc-snake -fN \
            {HPC_USER}@{HPC_HOST}

        ssh -S /tmp/hpc-snake \
            {HPC_USER}@{HPC_HOST} \
            "rm -rf {HPC_WORK}/labeling_views && \
             mkdir -p {HPC_WORK}/labeling_views"

        echo "Uploading views..."

        scp -o ControlPath=/tmp/hpc-snake -r \
            {VIEWS_DIR}/* \
            {HPC_USER}@{HPC_HOST}:{HPC_WORK}/labeling_views/

        scp -o ControlPath=/tmp/hpc-snake \
            {CONFIG_FILE} \
            {HPC_USER}@{HPC_HOST}:{HPC_WORK}/pipeline_config.yaml

        scp -o ControlPath=/tmp/hpc-snake \
            garfield/run_sam3_finetuned_pcs.py \
            {HPC_USER}@{HPC_HOST}:{HPC_WORK}/run_sam3_finetuned_pcs.py

        ssh -S /tmp/hpc-snake \
            {HPC_USER}@{HPC_HOST} \
            "rm -rf {HPC_WORK}/labeling_masks_finetuned && \
             mkdir -p {HPC_WORK}/labeling_masks_finetuned"

        echo "Running SAM3..."

        ssh -S /tmp/hpc-snake \
            {HPC_USER}@{HPC_HOST} \
            "set +u; \
             source activate {HPC_CONDA_ENV}; \
             set -u; \
             cd {HPC_WORK}/sam3_repo; \
             srun -t 02:00:00 \
                 -N1 \
                 -n1 \
                 --cpus-per-task=64 \
                 --gres=gpu:1 \
                 -p {HPC_PARTITION} \
                 -A {HPC_ACCOUNT} \
                 python {HPC_WORK}/run_sam3_finetuned_pcs.py \
                 --config-yaml {HPC_WORK}/pipeline_config.yaml"

        echo "Downloading masks..."

        rm -rf {MASKS_DIR}
        mkdir -p {MASKS_DIR}

        scp -o ControlPath=/tmp/hpc-snake -r \
            {HPC_USER}@{HPC_HOST}:{HPC_WORK}/labeling_masks_finetuned/* \
            {MASKS_DIR}/

        ssh -S /tmp/hpc-snake -O exit \
            {HPC_USER}@{HPC_HOST} 2>/dev/null || true

        echo "SAM3 inference complete."
        """


# ============================================================
# Stage 9: Merged Cluster → SAM3 Semantic Matching
# ============================================================

rule semantic_labeling:
    input:
        labels = f"{MERGE_DIR}/merged_labels.npy",
        points = f"{PROJECTION_OUTPUT}/points.npy",
        views = f"{VIEWS_DIR}/view_params.json",
        masks_done = SAM3_DONE,
        pipeline_cfg = CONFIG_FILE
    output:
        ply = f"{SEMANTIC_OUTPUT}/semantic_pointcloud.ply",
        json = f"{SEMANTIC_OUTPUT}/semantic_labels.json"
    shell:
        """
        echo "============================================"
        echo " Semantic Cluster Labeling"
        echo "============================================"

        set +u; source activate {ENV_NERFSTUDIO}; set -u

        python garfield/match_clusters_to_masks_finetuned.py \
            --features-dir {PROJECTION_OUTPUT} \
            --labels-npy {input.labels} \
            --views-dir {VIEWS_DIR} \
            --masks-dir {MASKS_DIR} \
            --output-dir {SEMANTIC_OUTPUT} \
            --min-iou {MATCH_MIN_IOU}
        """


# ============================================================
# Utility Rules
# ============================================================

rule clean:
    shell:
        """
        rm -f {DATASET_PATH}/.matching_done
        rm -f {GARFIELD_DONE}
        rm -f {GAUSS_DONE}
        rm -f {SAM3_DONE}

        echo "Cleaned pipeline marker files."
        """


rule clean_all:
    shell:
        """
        rm -rf {PROJECTION_OUTPUT}
        rm -rf {CLUSTER_DIR}
        rm -rf {MERGE_DIR}
        rm -rf {VIEWS_DIR}
        rm -rf {MASKS_DIR}
        rm -rf {SEMANTIC_OUTPUT}

        rm -f {SAM3_DONE}

        echo "Cleaned generated segmentation outputs."
        """
