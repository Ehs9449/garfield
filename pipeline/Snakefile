# ============================================================
# Drone-to-BIM Semantic Pipeline v2 — Integration Candidate
# ============================================================
# Existing pipeline/Snakefile and pipeline/config.yaml remain untouched.
# Video input + B-rep/IDF are intentionally deferred until this semantic DAG
# has been dry-run and validated.
# ============================================================

import os
import yaml

CONFIG_FILE = "pipeline/config.component_aware.yaml"
LOCAL_CONFIG_FILE = "pipeline/config.local.yaml"

def deep_update(base, update):
    if not update:
        return base
    for k, v in update.items():
        if isinstance(v, dict) and isinstance(base.get(k), dict):
            deep_update(base[k], v)
        else:
            base[k] = v
    return base

with open(CONFIG_FILE) as f:
    cfg = yaml.safe_load(f)

if os.path.isfile(LOCAL_CONFIG_FILE):
    with open(LOCAL_CONFIG_FILE) as f:
        deep_update(cfg, yaml.safe_load(f))

DATASET_PATH = cfg["dataset"]["path"]
DATASET_NAME = cfg["dataset"]["name"]
HAS_GPS = cfg["dataset"].get("has_gps", False)
OUT = f"outputs/{DATASET_NAME}"

def opath(rel):
    return os.path.join(OUT, rel)

ENV_COLMAP = cfg["colmap"]["conda_env"]
ENV_NERFSTUDIO = cfg["garfield"]["conda_env"]
CROP_CENTER = cfg["garfield"]["crop_center"]
CROP_SCALE = cfg["garfield"]["crop_scale"]

GARFIELD_CONFIG_TXT = opath("garfield_config.txt")
GAUSS_CONFIG_TXT = opath("garfield_gauss_config.txt")
GARFIELD_DONE = opath(".garfield_train_done")
GAUSS_DONE = opath(".garfield_gauss_train_done")
GARFIELD_SAM3_DONE = opath(".sam3_garfield_masks_done")
GARFIELD_SAM3_MASKS_DIR = opath("garfield_training_masks_sam3")
GARFIELD_TRAINING_IMAGES = os.path.join(DATASET_PATH, "images")

PROJECTION_OUTPUT = opath(cfg["projection"]["output_dir"])
PC_PATH = opath(cfg["projection"]["pointcloud"])
PROJECTION_SCALE = cfg["projection"]["scale"]
PROJ_N_SIDE = cfg["projection"].get("n_side", 4)
PROJ_SIDE_ELEVATIONS = " ".join(str(v) for v in cfg["projection"].get("side_elevations", [0.0]))
PROJ_N_TOP_RING = cfg["projection"].get("n_top_ring", 4)
PROJ_TOP_ELEVATIONS = " ".join(str(v) for v in cfg["projection"].get("top_elevations", [80.0]))
PROJ_AZIMUTH_OFFSET = cfg["projection"].get("azimuth_offset", 0.0)
PROJ_DIST_FACTOR = cfg["projection"].get("dist_factor", 1.5)
PROJ_RESOLUTION = cfg["projection"].get("resolution", 1080)

CLUSTER_SUITE = opath(cfg["clustering"]["suite_dir"])
K = cfg["clustering"].get("k", 400)
KMEANS_LABELS = f"{CLUSTER_SUITE}/03_spherical_kmeans/spherical_kmeans_k{K:03d}_labels.npy"
KMEANS_PLY = f"{CLUSTER_SUITE}/03_spherical_kmeans/spherical_kmeans_k{K:03d}.ply"

MERGE_ENABLED = bool(cfg["clustering"]["prototype_merge"].get("enabled", True))
MERGE_THRESHOLD = float(cfg["clustering"]["prototype_merge"].get("cosine_threshold", 0.90))
MERGE_TAG = f"{MERGE_THRESHOLD:.3f}".replace(".", "p")
MERGE_ROOT = opath(cfg["clustering"]["prototype_merge"]["output_dir"])
MERGED_LABELS = f"{MERGE_ROOT}/k{K:03d}/merge_cos_{MERGE_TAG}/spherical_kmeans_k{K:03d}_avg_cos_{MERGE_TAG}_labels.npy"
FINAL_CLUSTER_LABELS = MERGED_LABELS if MERGE_ENABLED else KMEANS_LABELS

AUTO_VIEWS = opath(cfg["semantic_views"]["baseline_auto_dir"])
AUTO_MASKS = opath(cfg["semantic_views"]["baseline_masks_dir"])
AUTO_SAM3_DONE = opath("production_v2/.sam3_auto_done")

REF_MODE = str(cfg["semantic_views"]["refinement"].get("mode", "auto")).lower()
if REF_MODE not in ("auto", "custom"):
    raise ValueError("semantic_views.refinement.mode must be auto or custom")

if REF_MODE == "auto":
    REFINEMENT_VIEWS = AUTO_VIEWS
    REFINEMENT_MASKS = AUTO_MASKS
    REFINEMENT_SAM3_DONE = AUTO_SAM3_DONE
else:
    REFINEMENT_VIEWS = opath(cfg["semantic_views"]["refinement"]["output_dir"])
    REFINEMENT_MASKS = opath(cfg["semantic_views"]["refinement"]["masks_dir"])
    REFINEMENT_SAM3_DONE = opath("production_v2/.sam3_refinement_done")

BASELINE_DIR = opath(cfg["matching"]["baseline"]["output_dir"])
POINTWISE_DIR = opath(cfg["matching"]["pointwise"]["output_dir"])
COMPONENT_DIR = opath(cfg["matching"]["component_aware"]["output_dir"])
SKY_CFG = cfg["matching"]["architecture_over_sky"]
SKY_DIR = opath(SKY_CFG["output_dir"])
FINAL_SEMANTIC_PLY = f"{SKY_DIR}/semantic_pointcloud.ply" if SKY_CFG.get("enabled", True) else f"{COMPONENT_DIR}/semantic_pointcloud.ply"

HPC_USER = cfg["hpc"]["user"]
HPC_HOST = cfg["hpc"]["host"]
HPC_WORK = cfg["hpc"]["work_dir"]
HPC_ACCOUNT = cfg["hpc"]["account"]
HPC_PARTITION = cfg["hpc"]["partition"]
HPC_CPUS = cfg["hpc"].get("cpus_per_task", 8)
HPC_GPUS = cfg["hpc"].get("gpus", 1)
HPC_TIME_LIMIT = cfg["hpc"].get("time_limit", "04:00:00")
HPC_CONDA_ENV = cfg["sam3"]["hpc_conda_env"]

rule all:
    input:
        FINAL_SEMANTIC_PLY

# ============================================================
# Stage 1: COLMAP
# ============================================================

rule colmap_feature_extract:
    input:
        images = f"{DATASET_PATH}/images"
    output:
        db = f"{DATASET_PATH}/database.db"
    shell:
        """
        set +u; source activate {ENV_COLMAP}; set -u
        colmap feature_extractor --database_path {output.db} --image_path {input.images}
        """

rule colmap_matching:
    input:
        db = ancient(f"{DATASET_PATH}/database.db")
    output:
        done = touch(f"{DATASET_PATH}/.matching_done")
    run:
        if HAS_GPS:
            shell("set +u; source activate {ENV_COLMAP}; set -u; colmap spatial_matcher --database_path {input.db}")
        else:
            shell("set +u; source activate {ENV_COLMAP}; set -u; colmap sequential_matcher --database_path {input.db}")

rule colmap_mapper:
    input:
        db = f"{DATASET_PATH}/database.db",
        done = f"{DATASET_PATH}/.matching_done",
        images = f"{DATASET_PATH}/images"
    output:
        sparse = directory(f"{DATASET_PATH}/sparse/0")
    shell:
        r"""
        set +u; source activate {ENV_COLMAP}; set -u
        RAW_MODELS="{DATASET_PATH}/colmap_models_raw"
        rm -rf "$RAW_MODELS"; mkdir -p "$RAW_MODELS"
        colmap mapper --database_path {input.db} --image_path {input.images} --output_path "$RAW_MODELS"
        BEST_MODEL=""; BEST_COUNT=-1
        for MODEL_DIR in "$RAW_MODELS"/*; do
          [ -d "$MODEL_DIR" ] || continue
          COUNT=$(colmap model_analyzer --path "$MODEL_DIR" 2>&1 | awk -F': ' '/Registered images:/ {{print $2}}' | tail -1)
          [ -n "$COUNT" ] || COUNT=0
          echo "COLMAP model $(basename "$MODEL_DIR"): $COUNT registered images"
          if [ "$COUNT" -gt "$BEST_COUNT" ]; then BEST_COUNT="$COUNT"; BEST_MODEL="$MODEL_DIR"; fi
        done
        [ -n "$BEST_MODEL" ] || {{ echo "ERROR: no COLMAP reconstruction" >&2; exit 1; }}
        mkdir -p "{DATASET_PATH}/sparse"; rm -rf "{DATASET_PATH}/sparse/0"
        cp -a "$BEST_MODEL" "{DATASET_PATH}/sparse/0"
        echo "Selected $(basename "$BEST_MODEL") with $BEST_COUNT registered images"
        """

# ============================================================
# Stage 2: SAM3 grouping masks + GARField / GARField-Gauss
# ============================================================

rule sam3_garfield_masks:
    input:
        images = GARFIELD_TRAINING_IMAGES,
        sparse = f"{DATASET_PATH}/sparse/0",
        pipeline_cfg = CONFIG_FILE
    output:
        done = touch(GARFIELD_SAM3_DONE)
    shell:
        r"""
        rm -f /tmp/hpc-snake
        ssh -M -S /tmp/hpc-snake -fN {HPC_USER}@{HPC_HOST}
        ssh -S /tmp/hpc-snake {HPC_USER}@{HPC_HOST} \
          "rm -rf {HPC_WORK}/garfield_training_images {HPC_WORK}/garfield_training_masks_sam3; \
           mkdir -p {HPC_WORK}/garfield_training_images {HPC_WORK}/garfield_training_masks_sam3"
        scp -o ControlPath=/tmp/hpc-snake -r {GARFIELD_TRAINING_IMAGES}/* \
          {HPC_USER}@{HPC_HOST}:{HPC_WORK}/garfield_training_images/
        scp -o ControlPath=/tmp/hpc-snake {CONFIG_FILE} \
          {HPC_USER}@{HPC_HOST}:{HPC_WORK}/pipeline_config.yaml
        scp -o ControlPath=/tmp/hpc-snake garfield/run_sam3_finetuned_garfield.py \
          {HPC_USER}@{HPC_HOST}:{HPC_WORK}/run_sam3_finetuned_garfield.py
        ssh -S /tmp/hpc-snake {HPC_USER}@{HPC_HOST} \
          "set +u; source activate {HPC_CONDA_ENV}; set -u; cd {HPC_WORK}/sam3_repo; \
           srun -t {HPC_TIME_LIMIT} -N1 -n1 --cpus-per-task={HPC_CPUS} --gres=gpu:{HPC_GPUS} \
           -p {HPC_PARTITION} -A {HPC_ACCOUNT} \
           python -u {HPC_WORK}/run_sam3_finetuned_garfield.py --config-yaml {HPC_WORK}/pipeline_config.yaml"
        rm -rf {GARFIELD_SAM3_MASKS_DIR}; mkdir -p {GARFIELD_SAM3_MASKS_DIR}
        scp -o ControlPath=/tmp/hpc-snake -r \
          {HPC_USER}@{HPC_HOST}:{HPC_WORK}/garfield_training_masks_sam3/* {GARFIELD_SAM3_MASKS_DIR}/
        ssh -S /tmp/hpc-snake -O exit {HPC_USER}@{HPC_HOST} 2>/dev/null || true
        """

rule garfield_train:
    input:
        sparse = f"{DATASET_PATH}/sparse/0",
        sam3_masks = GARFIELD_SAM3_DONE
    output:
        done = touch(GARFIELD_DONE),
        config_txt = GARFIELD_CONFIG_TXT
    shell:
        r"""
        set +u; source activate {ENV_NERFSTUDIO}; set -u
        ns-train garfield --viewer.quit-on-train-completion True \
          colmap --data {DATASET_PATH} --colmap-path sparse/0/ --downscale-factor 1
        GARFIELD_CONFIG=$(realpath $(find outputs -path "*/garfield/*/config.yml" -type f \
          -printf "%T@ %p\n" | sort -nr | head -1 | cut -d" " -f2-))
        test -f "$GARFIELD_CONFIG"
        mkdir -p {OUT}; echo "$GARFIELD_CONFIG" > {output.config_txt}
        """

rule garfield_gauss_train:
    input:
        sparse = f"{DATASET_PATH}/sparse/0",
        garfield_done = GARFIELD_DONE,
        garfield_config_txt = GARFIELD_CONFIG_TXT
    output:
        done = touch(GAUSS_DONE),
        config_txt = GAUSS_CONFIG_TXT
    shell:
        r"""
        GARFIELD_CONFIG=$(cat {input.garfield_config_txt}); test -f "$GARFIELD_CONFIG"
        set +u; source activate {ENV_NERFSTUDIO}; set -u
        ns-train garfield-gauss --pipeline.garfield-ckpt "$GARFIELD_CONFIG" \
          --viewer.quit-on-train-completion True \
          --pipeline.datamanager.camera-res-scale-factor 0.25 \
          --pipeline.datamanager.cache-images cpu \
          colmap --data {DATASET_PATH} --colmap-path sparse/0/
        GAUSS_CONFIG=$(realpath $(find outputs -path "*/garfield-gauss/*/config.yml" -type f \
          -printf "%T@ %p\n" | sort -nr | head -1 | cut -d" " -f2-))
        test -f "$GAUSS_CONFIG"
        mkdir -p {OUT}; echo "$GAUSS_CONFIG" > {output.config_txt}
        """

# ============================================================
# Stage 3: point cloud + feature projection
# ============================================================

rule export_garfield_pointcloud:
    input:
        garfield_done = GARFIELD_DONE,
        garfield_config_txt = GARFIELD_CONFIG_TXT
    output:
        pc = PC_PATH
    shell:
        r"""
        GARFIELD_CONFIG=$(cat {input.garfield_config_txt}); test -f "$GARFIELD_CONFIG"
        set +u; source activate {ENV_NERFSTUDIO}; set -u
        ns-export pointcloud --load-config "$GARFIELD_CONFIG" \
          --output-dir $(dirname {output.pc}) --num-points 1000000 \
          --remove-outliers True --normal-method open3d --save-world-frame False
        test -f {output.pc}
        """

rule ortho_projection:
    input:
        garfield_done = GARFIELD_DONE,
        garfield_config_txt = GARFIELD_CONFIG_TXT,
        pc = PC_PATH,
        pipeline_cfg = CONFIG_FILE
    output:
        features = f"{PROJECTION_OUTPUT}/avg_features.npy",
        points = f"{PROJECTION_OUTPUT}/points.npy",
        colors = f"{PROJECTION_OUTPUT}/colors.npy"
    shell:
        r"""
        GARFIELD_CONFIG=$(cat {input.garfield_config_txt}); test -f "$GARFIELD_CONFIG"
        set +u; source activate {ENV_NERFSTUDIO}; set -u
        python garfield/garfield_ortho_projection_guided_plus_top.py \
          --config "$GARFIELD_CONFIG" --pointcloud {input.pc} --scale {PROJECTION_SCALE} \
          --crop-center {CROP_CENTER[0]} {CROP_CENTER[1]} {CROP_CENTER[2]} \
          --crop-scale {CROP_SCALE[0]} {CROP_SCALE[1]} {CROP_SCALE[2]} \
          --n-side {PROJ_N_SIDE} --side-elevations {PROJ_SIDE_ELEVATIONS} \
          --n-top-ring {PROJ_N_TOP_RING} --top-elevations {PROJ_TOP_ELEVATIONS} \
          --azimuth-offset {PROJ_AZIMUTH_OFFSET} --dist-factor {PROJ_DIST_FACTOR} \
          --resolution {PROJ_RESOLUTION} --output-dir {PROJECTION_OUTPUT}
        """

# ============================================================
# Stage 4: K400 feature-only clustering
# ============================================================

rule k400_clustering:
    input:
        points = f"{PROJECTION_OUTPUT}/points.npy",
        features = f"{PROJECTION_OUTPUT}/avg_features.npy"
    output:
        labels = KMEANS_LABELS,
        ply = KMEANS_PLY
    shell:
        r"""
        set +u; source activate {ENV_NERFSTUDIO}; set -u
        python pipeline/scripts/spherical_kmeans_k400.py \
          --points {input.points} --features {input.features} \
          --output-root {CLUSTER_SUITE} --k {K} \
          --niter {cfg[clustering][niter]} --nredo {cfg[clustering][nredo]} \
          --seed {cfg[clustering][seed]}
        """

if MERGE_ENABLED:
    rule prototype_merge:
        input:
            points = f"{PROJECTION_OUTPUT}/points.npy",
            features = f"{PROJECTION_OUTPUT}/avg_features.npy",
            labels = KMEANS_LABELS
        output:
            labels = MERGED_LABELS
        shell:
            r"""
            set +u; source activate {ENV_NERFSTUDIO}; set -u
            python pipeline/scripts/merge_kmeans_prototypes.py \
              --points {input.points} --features {input.features} \
              --suite-root {CLUSTER_SUITE} --output-root {MERGE_ROOT} \
              --k {K} --cosine-thresholds {MERGE_THRESHOLD}
            test -f {output.labels}
            """

# ============================================================
# Stage 5: AUTO broad semantic view bank + SAM3
# ============================================================

rule render_auto_semantic_views:
    input:
        gauss_done = GAUSS_DONE,
        gauss_config_txt = GAUSS_CONFIG_TXT,
        pipeline_cfg = CONFIG_FILE
    output:
        params = f"{AUTO_VIEWS}/view_params.json"
    shell:
        r"""
        GAUSS_CONFIG=$(cat {input.gauss_config_txt}); test -f "$GAUSS_CONFIG"
        set +u; source activate {ENV_NERFSTUDIO}; set -u
        python garfield/render_views_colmap_guided.py \
          --config "$GAUSS_CONFIG" --output-dir {AUTO_VIEWS} --config-yaml {CONFIG_FILE}
        """

rule sam3_auto_semantic_views:
    input:
        params = f"{AUTO_VIEWS}/view_params.json",
        config = CONFIG_FILE
    output:
        done = touch(AUTO_SAM3_DONE)
    shell:
        r"""
        bash pipeline/scripts/run_sam3_hpc_generic.sh \
          --views {AUTO_VIEWS} --out {AUTO_MASKS} --config {CONFIG_FILE} --tag auto
        """

# ============================================================
# Stage 6: baseline broad K400 cluster semantics
# ============================================================

rule baseline_cluster_semantics:
    input:
        labels = FINAL_CLUSTER_LABELS,
        points = f"{PROJECTION_OUTPUT}/points.npy",
        views = f"{AUTO_VIEWS}/view_params.json",
        sam3 = AUTO_SAM3_DONE
    output:
        labels_json = f"{BASELINE_DIR}/semantic_labels.json",
        ply = f"{BASELINE_DIR}/semantic_pointcloud.ply"
    params:
        confidence_flag = "--use-sam3-confidence" if cfg["matching"]["baseline"].get("use_sam3_confidence", False) else ""
    shell:
        r"""
        set +u; source activate {ENV_NERFSTUDIO}; set -u
        python pipeline/scripts/match_clusters_multiclass_evidence.py \
          --features-dir {PROJECTION_OUTPUT} --labels-npy {input.labels} \
          --views-dir {AUTO_VIEWS} --masks-dir {AUTO_MASKS} \
          --output-dir {BASELINE_DIR} \
          --min-iou {cfg[matching][baseline][min_iou]} \
          --min-supporting-views {cfg[matching][baseline][min_supporting_views]} \
          {params.confidence_flag}
        """

# ============================================================
# Stage 7: AUTO or CUSTOM refinement views
# ============================================================

if REF_MODE == "custom":
    CAMERA_PATH = cfg["semantic_views"]["refinement"]["camera_path"]
    REF_FRAMES = cfg["semantic_views"]["refinement"].get("frames", 96)
    REF_WIDTH = cfg["semantic_views"]["refinement"].get("width", 1600)
    REF_FOV = cfg["semantic_views"]["refinement"].get("fov_deg", None)
    REF_CROP = bool(cfg["semantic_views"]["refinement"].get("crop", True))
    FOV_ARG = "" if REF_FOV is None else f"--fov-deg {REF_FOV}"
    CROP_ARG = "" if REF_CROP else "--no-crop"

    rule render_refinement_views:
        input:
            gauss_done = GAUSS_DONE,
            gauss_config_txt = GAUSS_CONFIG_TXT,
            camera_path = CAMERA_PATH,
            config = CONFIG_FILE
        output:
            params = f"{REFINEMENT_VIEWS}/view_params.json"
        shell:
            r"""
            set +u; source activate {ENV_NERFSTUDIO}; set -u
            python pipeline/scripts/render_camera_path.py \
              --camera-path {input.camera_path} \
              --gauss-config-txt {input.gauss_config_txt} \
              --pipeline-config {CONFIG_FILE} \
              --output-dir {REFINEMENT_VIEWS} \
              --frames {REF_FRAMES} --width {REF_WIDTH} {FOV_ARG} {CROP_ARG} --overwrite
            """

    rule sam3_refinement_views:
        input:
            params = f"{REFINEMENT_VIEWS}/view_params.json",
            config = CONFIG_FILE
        output:
            done = touch(REFINEMENT_SAM3_DONE)
        shell:
            r"""
            bash pipeline/scripts/run_sam3_hpc_generic.sh \
              --views {REFINEMENT_VIEWS} --out {REFINEMENT_MASKS} \
              --config {CONFIG_FILE} --tag refinement
            """

# ============================================================
# Stage 8: pointwise multiclass matching
# ============================================================

rule pointwise_multiclass_matching:
    input:
        points = f"{PROJECTION_OUTPUT}/points.npy",
        labels = FINAL_CLUSTER_LABELS,
        baseline = f"{BASELINE_DIR}/semantic_labels.json",
        views = f"{REFINEMENT_VIEWS}/view_params.json",
        sam3 = REFINEMENT_SAM3_DONE
    output:
        labels = f"{POINTWISE_DIR}/semantic/semantic_labels_pointwise.npy",
        ply = f"{POINTWISE_DIR}/semantic/semantic_pointcloud_multiclass_pointwise.ply"
    shell:
        r"""
        set +u; source activate {ENV_NERFSTUDIO}; set -u
        python pipeline/scripts/match_viewer_multiclass.py \
          --points {input.points} --labels {input.labels} \
          --views {REFINEMENT_VIEWS} --masks {REFINEMENT_MASKS} \
          --baseline {input.baseline} \
          --previous-pointwise {POINTWISE_DIR}/_none.npy \
          --output {POINTWISE_DIR} \
          --min-sam3-score {cfg[matching][pointwise][min_sam3_score]} \
          --min-evidence-views {cfg[matching][pointwise][min_evidence_views]} \
          --min-point-ratio {cfg[matching][pointwise][min_point_ratio]} \
          --min-weighted-score {cfg[matching][pointwise][min_weighted_score]} \
          --window-erode {cfg[matching][pointwise][window_erode]} \
          --window-bonus {cfg[matching][pointwise][window_bonus]} \
          --tile {cfg[matching][pointwise][zbuffer_tile]} \
          --abs-tolerance {cfg[matching][pointwise][depth_abs_tolerance]} \
          --rel-tolerance {cfg[matching][pointwise][depth_rel_tolerance]}
        """

# ============================================================
# Stage 9: generalized component-aware refinement
# ============================================================

COMP_CFG = cfg["matching"]["component_aware"]

rule component_aware_refinement:
    input:
        points = f"{PROJECTION_OUTPUT}/points.npy",
        labels = f"{POINTWISE_DIR}/semantic/semantic_labels_pointwise.npy",
        views = f"{REFINEMENT_VIEWS}/view_params.json",
        sam3 = REFINEMENT_SAM3_DONE
    output:
        labels = f"{COMPONENT_DIR}/semantic_labels.npy",
        ply = f"{COMPONENT_DIR}/semantic_pointcloud.ply"
    shell:
        r"""
        set +u; source activate {ENV_NERFSTUDIO}; set -u
        python pipeline/scripts/refine_component_aware_priority.py \
          --points {input.points} --viewer-labels {input.labels} \
          --views {REFINEMENT_VIEWS} --masks {REFINEMENT_MASKS} \
          --output {COMPONENT_DIR} \
          --min-sam3-score {COMP_CFG[min_sam3_score]} \
          --min-views {COMP_CFG[min_views]} --min-ratio {COMP_CFG[min_ratio]} \
          --min-views-overrides "{COMP_CFG[min_views_overrides]}" \
          --min-ratio-overrides "{COMP_CFG[min_ratio_overrides]}" \
          --erosion-overrides "{COMP_CFG[erosion_overrides]}"
        """

# ============================================================
# Stage 10: architecture > sky cleanup
# ============================================================

if SKY_CFG.get("enabled", True):
    rule architecture_over_sky:
        input:
            points = f"{PROJECTION_OUTPUT}/points.npy",
            labels = f"{COMPONENT_DIR}/semantic_labels.npy",
            views = f"{REFINEMENT_VIEWS}/view_params.json",
            sam3 = REFINEMENT_SAM3_DONE
        output:
            labels = f"{SKY_DIR}/semantic_labels.npy",
            ply = f"{SKY_DIR}/semantic_pointcloud.ply"
        shell:
            r"""
            set +u; source activate {ENV_NERFSTUDIO}; set -u
            python pipeline/scripts/architecture_over_sky.py \
              --points {input.points} --semantic-labels {input.labels} \
              --views {REFINEMENT_VIEWS} --masks {REFINEMENT_MASKS} \
              --output {SKY_DIR} --min-sam3-score {SKY_CFG[min_sam3_score]}
            """

rule clean_v2_semantics:
    shell:
        r"""
        rm -rf {OUT}/production_v2
        echo "Removed {OUT}/production_v2 only."
        """
