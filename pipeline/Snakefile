# ============================================================
# Drone-to-BIM Semantic Segmentation Pipeline
# ============================================================
#
# Two parallel branches:
#   Branch A: GARField → Ortho Projection → Clustering
#   Branch B: GARField-Gauss → Render Views → SAM 3 PCS
#   Merge:    Cluster Matching → Semantic Point Cloud
#
# Usage:
#   snakemake -s pipeline/Snakefile --cores 4 all
#   snakemake -s pipeline/Snakefile --cores 4 colmap
#   snakemake -s pipeline/Snakefile --cores 4 clustering
#   snakemake -s pipeline/Snakefile --cores 4 semantic_labeling
#   snakemake -s pipeline/Snakefile -n all              # Dry run
#   snakemake -s pipeline/Snakefile --cores 4 clean     # Clean outputs
#
# ============================================================

import yaml
import glob
import os

# Load config
CONFIG_FILE = "pipeline/config.yaml"
with open(CONFIG_FILE) as f:
    cfg = yaml.safe_load(f)

DATASET_PATH = cfg["dataset"]["path"]
DATASET_NAME = cfg["dataset"]["name"]
HAS_GPS = cfg["dataset"]["has_gps"]

PROJECTION_SCALE = cfg["projection"]["scale"]
PROJECTION_OUTPUT = cfg["projection"]["output_dir"]
PC_PATH = cfg["projection"]["pointcloud"]

VIEWS_DIR = cfg["labeling_views"]["output_dir"]

CLUSTER_N_TRIALS = cfg["clustering"].get("n_trials", 40)
CLUSTER_SAMPLE_SIZE = cfg["clustering"].get("sample_size", 50000)
MASKS_DIR = "outputs/labeling_masks_finetuned"
FEATURES_DIR = cfg["matching"]["features_dir"]
LABELS_NPY = cfg["matching"]["labels_npy"]
SEMANTIC_OUTPUT = cfg["matching"]["output_dir"]

GARFIELD_CONFIG_TXT = f"outputs/{DATASET_NAME}/garfield_config.txt"
GAUSS_CONFIG_TXT = f"outputs/{DATASET_NAME}/garfield_gauss_config.txt"

GARFIELD_DONE = f"outputs/{DATASET_NAME}/.garfield_train_done"
GAUSS_DONE = f"outputs/{DATASET_NAME}/.garfield_gauss_train_done"
SAM3_DONE = f"outputs/{DATASET_NAME}/.sam3_inference_done"

GARFIELD_DONE = f"outputs/{DATASET_NAME}/.garfield_train_done"
GAUSS_DONE = f"outputs/{DATASET_NAME}/.garfield_gauss_train_done"
SAM3_DONE = f"outputs/{DATASET_NAME}/.sam3_inference_done"

# Conda environments
ENV_COLMAP = cfg["colmap"]["conda_env"]
ENV_NERFSTUDIO = cfg["garfield"]["conda_env"]

# HPC config
HPC_USER = cfg["hpc"]["user"]
HPC_HOST = cfg["hpc"]["host"]
HPC_WORK = cfg["hpc"]["work_dir"]
HPC_ACCOUNT = cfg["hpc"]["account"]
HPC_PARTITION = cfg["hpc"]["partition"]
HF_TOKEN = cfg["hpc"]["hf_token"]

SAM3_CONFIDENCE = cfg["sam3"]["confidence_threshold"]
SAM3_CHECKPOINT = cfg["sam3"]["checkpoint"]
SAM3_BPE_PATH = cfg["sam3"]["bpe_path"]
MATCH_MIN_IOU = cfg["matching"]["min_iou"]

# ============================================================
# Helper: auto-detect latest nerfstudio config
# ============================================================

def find_latest_config(model_type):
    """Find the latest config.yml for a given model type (garfield or garfield-gauss)."""
    pattern = f"outputs/*/{model_type}/*/config.yml"
    configs = sorted(glob.glob(pattern), key=os.path.getmtime, reverse=True)
    if configs:
        return configs[0]
    return None

# ============================================================
# Target rules
# ============================================================

rule all:
    input:
        f"{SEMANTIC_OUTPUT}/semantic_pointcloud.ply"

# ============================================================
# Stage 1: COLMAP - Structure from Motion
# ============================================================

rule colmap_feature_extract:
    input:
        images = f"{DATASET_PATH}/images"
    output:
        db = f"{DATASET_PATH}/database.db"
    shell:
        """
        set +u; source activate {ENV_COLMAP}; set -u; colmap feature_extractor \
                --database_path {output.db} \
                --image_path {input.images}
        """

rule colmap_matching:
    input:
        db = ancient(f"{DATASET_PATH}/database.db")
    output:
        done = touch(f"{DATASET_PATH}/.matching_done")
    run:
        if HAS_GPS:
            shell("set +u; source activate {ENV_COLMAP}; set -u; colmap spatial_matcher --database_path {input.db}")
        else:
            shell("set +u; source activate {ENV_COLMAP}; set -u; colmap sequential_matcher --database_path {input.db}")

rule colmap_mapper:
    input:
        db = f"{DATASET_PATH}/database.db",
        done = f"{DATASET_PATH}/.matching_done",
        images = f"{DATASET_PATH}/images"
    output:
        sparse = directory(f"{DATASET_PATH}/sparse/0")
    shell:
        """
        set +u; source activate {ENV_COLMAP}; set -u; colmap mapper \
                --database_path {input.db} \
                --image_path {input.images} \
                --output_path {DATASET_PATH}

        mkdir -p {DATASET_PATH}/sparse
        [ -d "{DATASET_PATH}/0" ] && mv {DATASET_PATH}/0 {DATASET_PATH}/sparse/ || true
        [ -d "{DATASET_PATH}/1" ] && mv {DATASET_PATH}/1 {DATASET_PATH}/sparse/ || true
        """

rule colmap:
    input:
        f"{DATASET_PATH}/sparse/0"

# ============================================================
# Stage 2a: GARField (NeRF) Training
#   → Provides 256-dim grouping features for projection
# ============================================================

rule garfield_train:
    input:
        sparse = f"{DATASET_PATH}/sparse/0"
    output:
        done = touch(GARFIELD_DONE),
        config_txt = GARFIELD_CONFIG_TXT
    shell:
        """
        echo "============================================"
        echo "  Stage 2a: GARField (NeRF) Training"
        echo "  This will take several hours."
        echo "============================================"

        set +u; source activate {ENV_NERFSTUDIO}; set -u; ns-train garfield --viewer.quit-on-train-completion True colmap \
                --data data/{DATASET_NAME} \
                --colmap-path sparse/0/

        GARFIELD_CONFIG=$(realpath $(find outputs -path "*/garfield/*/config.yml" -type f -printf "%T@ %p\n" | sort -nr | head -1 | cut -d" " -f2-))
        test -f "$GARFIELD_CONFIG"
        mkdir -p outputs/{DATASET_NAME}
        echo "$GARFIELD_CONFIG" > {output.config_txt}

        echo ""
        echo "GARField training complete."
        echo "Config saved to: $GARFIELD_CONFIG"
        """

# ============================================================
# Stage 2b: GARField-Gauss (Gaussian Splatting) Training
#   → Provides clean RGB rendering for SAM 3 labeling views
# ============================================================

rule garfield_gauss_train:
    input:
        sparse = f"{DATASET_PATH}/sparse/0",
        garfield_done = GARFIELD_DONE,
        garfield_config_txt = GARFIELD_CONFIG_TXT
    output:
        done = touch(GAUSS_DONE),
        config_txt = GAUSS_CONFIG_TXT
    shell:
        """
        echo "============================================"
        echo "  Stage 2b: GARField-Gauss Training"
        echo "  This will take several hours."
        echo "============================================"

        GARFIELD_CONFIG=$(cat {input.garfield_config_txt})
        test -f "$GARFIELD_CONFIG"
        set +u; source activate {ENV_NERFSTUDIO}; set -u; ns-train garfield-gauss \
                --pipeline.garfield-ckpt $GARFIELD_CONFIG \
                --viewer.quit-on-train-completion True \
                --data data/{DATASET_NAME} \
                --pipeline.datamanager.camera-res-scale-factor 0.25 \
                --pipeline.datamanager.cache-images cpu

        GAUSS_CONFIG=$(realpath $(find outputs -path "*/garfield-gauss/*/config.yml" -type f -printf "%T@ %p\n" | sort -nr | head -1 | cut -d" " -f2-))
        test -f "$GAUSS_CONFIG"
        mkdir -p outputs/{DATASET_NAME}
        echo "$GAUSS_CONFIG" > {output.config_txt}

        echo ""
        echo "GARField-Gauss training complete."
        echo "Config saved to: $GAUSS_CONFIG"
        """

# ============================================================
# Stage 3: Orthographic Feature Projection (uses GARField)
# ============================================================

rule export_garfield_pointcloud:
    input:
        garfield_done = GARFIELD_DONE,
        garfield_config_txt = GARFIELD_CONFIG_TXT

    output:
        pc = PC_PATH

    shell:
        """
        GARFIELD_CONFIG=$(cat {input.garfield_config_txt})
        test -f "$GARFIELD_CONFIG"

        echo "============================================"
        echo " Exporting GARField Point Cloud"
        echo "============================================"
        echo "Using config: $GARFIELD_CONFIG"

        set +u; source activate nerfstudio3; set -u; ns-export pointcloud \
            --load-config "$GARFIELD_CONFIG" \
            --output-dir $(dirname {output.pc}) \
            --num-points 1000000 \
            --remove-outliers True \
            --normal-method open3d \
            --save-world-frame False

        test -f {output.pc}
        """

rule ortho_projection:
    input:
        garfield_done = GARFIELD_DONE,
        garfield_config_txt = GARFIELD_CONFIG_TXT,
        pc = PC_PATH,
        pipeline_cfg = CONFIG_FILE
    output:
        features = f"{PROJECTION_OUTPUT}/avg_features.npy",
        points = f"{PROJECTION_OUTPUT}/points.npy"
    shell:
        """
        GARFIELD_CONFIG=$(cat {input.garfield_config_txt})
        test -f "$GARFIELD_CONFIG"
        echo "Using GARField config: $GARFIELD_CONFIG"

        cd /home/eaghae1/garfield-semantic
        set +u; source activate {ENV_NERFSTUDIO}; set -u; python garfield/garfield_ortho_projection.py \
                --config $GARFIELD_CONFIG \
                --pointcloud {input.pc} \
                --scale {PROJECTION_SCALE} \
                --output-dir {PROJECTION_OUTPUT}
        """

# ============================================================
# Stage 4: HDBSCAN Clustering
# ============================================================

rule clustering:
    input:
        features = f"{PROJECTION_OUTPUT}/avg_features.npy",
        points = f"{PROJECTION_OUTPUT}/points.npy",
        pipeline_cfg = CONFIG_FILE
    output:
        labels = f"{FEATURES_DIR}/cluster_labels.npy"
    shell:
        """
        set +u; source activate {ENV_NERFSTUDIO}; set -u; python garfield/cluster_sweep.py \
                --input-dir {PROJECTION_OUTPUT} \
                --output-dir {FEATURES_DIR} \
                --n-trials {CLUSTER_N_TRIALS} \
                --sample-size {CLUSTER_SAMPLE_SIZE}
        """

# ============================================================
# Stage 5: Render Labeling Views (uses GARField-Gauss)
# ============================================================

rule render_views:
    input:
        gauss_done = GAUSS_DONE,
        gauss_config_txt = GAUSS_CONFIG_TXT,
        pipeline_cfg = CONFIG_FILE
    output:
        params = f"{VIEWS_DIR}/view_params.json"
    shell:
        """
        GAUSS_CONFIG=$(cat {input.gauss_config_txt})
        test -f "$GAUSS_CONFIG"
        echo "Using GARField-Gauss config: $GAUSS_CONFIG"

        set +u; source activate {ENV_NERFSTUDIO}; set -u; python garfield/render_views_for_labeling.py \
                --config $GAUSS_CONFIG \
                --output-dir {VIEWS_DIR} \
                --config-yaml {CONFIG_FILE}
        """

# ============================================================
# Stage 6: SAM 3 PCS Inference (on HPC)
# ============================================================

rule sam3_inference:
    input:
        views = f"{VIEWS_DIR}/view_params.json",
        pipeline_cfg = CONFIG_FILE
    output:
        done = touch(SAM3_DONE)
    shell:
        """
        echo "============================================"
        echo "  Stage 6: SAM 3 Inference on HPC"
        echo "  Enter HPC password when prompted"
        echo "============================================"

        # Open persistent SSH connection (password asked once)
        ssh -M -S /tmp/hpc-snake -fN {HPC_USER}@{HPC_HOST}

        # Clean old views on HPC so previous experiments do not mix with the current run
        ssh -S /tmp/hpc-snake {HPC_USER}@{HPC_HOST} \
            "rm -rf {HPC_WORK}/labeling_views && mkdir -p {HPC_WORK}/labeling_views"

        # Upload views to HPC
        echo "Uploading views to HPC..."
        scp -o ControlPath=/tmp/hpc-snake -r \
            {VIEWS_DIR}/* {HPC_USER}@{HPC_HOST}:{HPC_WORK}/labeling_views/

        # Upload pipeline config to HPC
        scp -o ControlPath=/tmp/hpc-snake pipeline/config.yaml \
            {HPC_USER}@{HPC_HOST}:{HPC_WORK}/pipeline_config.yaml

        # SAM3 inference script is already stored on HPC at:
        # {HPC_WORK}/run_sam3_finetuned_pcs.py

        # Run SAM 3 on HPC
        echo "Running SAM 3 inference on HPC..."
        ssh -S /tmp/hpc-snake {HPC_USER}@{HPC_HOST} bash -c '
            set +u; source activate {HPC_WORK}/conda_envs/sam3; set -u
            export HF_TOKEN="{HF_TOKEN}"
            export HF_HOME={HPC_WORK}/.cache/huggingface
            cd {HPC_WORK}/sam3_repo
            srun -t 02:00:00 -N1 -n1 --cpus-per-task=64 --gres=gpu:1 -p {HPC_PARTITION} -A {HPC_ACCOUNT} \
                python {HPC_WORK}/run_sam3_finetuned_pcs.py --config-yaml {HPC_WORK}/pipeline_config.yaml
        '

        # Download results
        echo "Downloading masks from HPC..."
        mkdir -p {MASKS_DIR}
        scp -o ControlPath=/tmp/hpc-snake -r \
            {HPC_USER}@{HPC_HOST}:{HPC_WORK}/labeling_masks_finetuned/* \
            {MASKS_DIR}/

        # Close SSH connection
        ssh -S /tmp/hpc-snake -O exit {HPC_USER}@{HPC_HOST} 2>/dev/null || true

        echo "SAM 3 inference complete."
        """

# ============================================================
# Stage 7: Cluster-to-Mask Matching
# ============================================================

rule semantic_labeling:
    input:
        labels = f"{FEATURES_DIR}/cluster_labels.npy",
        views = f"{VIEWS_DIR}/view_params.json",
        masks_done = SAM3_DONE,
        pipeline_cfg = CONFIG_FILE
    output:
        ply = f"{SEMANTIC_OUTPUT}/semantic_pointcloud.ply",
        json = f"{SEMANTIC_OUTPUT}/semantic_labels.json"
    shell:
        """
        set +u; source activate {ENV_NERFSTUDIO}; set -u; python garfield/match_clusters_to_masks_finetuned.py \
                --features-dir {FEATURES_DIR} \
                --labels-npy {LABELS_NPY} \
                --views-dir {VIEWS_DIR} \
                --masks-dir {MASKS_DIR} \
                --output-dir {SEMANTIC_OUTPUT} \
                --min-iou {MATCH_MIN_IOU}
        """

# ============================================================
# Utility rules
# ============================================================

rule clean:
    shell:
        """
        rm -f {DATASET_PATH}/database.db
        rm -f {DATASET_PATH}/.matching_done
        rm -f outputs/.garfield_train_done
        rm -f outputs/.garfield_gauss_train_done
        rm -f outputs/.sam3_inference_done
        echo "Cleaned marker files."
        """

rule clean_all:
    shell:
        """
        rm -rf {PROJECTION_OUTPUT}
        rm -rf {VIEWS_DIR}
        rm -rf {MASKS_DIR}
        rm -rf {SEMANTIC_OUTPUT}
        rm -f {DATASET_PATH}/database.db
        rm -f {DATASET_PATH}/.matching_done
        rm -f outputs/.garfield_train_done
        rm -f outputs/.garfield_gauss_train_done
        rm -f outputs/.sam3_inference_done
        echo "Cleaned all outputs."
        """
